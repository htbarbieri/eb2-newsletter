---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { timelineSideLabels, timelineSideLabelsShort } from '../../data/timeline-labels'

export async function getStaticPaths() {
  const events = await getCollection('timeline')
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }))
}

const { event } = Astro.props
const { Content } = await render(event)

const sideLabel = timelineSideLabels[event.data.side]
const sideClass =
  event.data.side === 'br'
    ? 'bg-br-green/10 text-br-green'
    : 'bg-us-navy/10 text-us-navy'
---

<BaseLayout title={event.data.title} description={event.data.excerpt}>
  <article class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
    <a
      href="/#timeline"
      class="inline-flex min-h-[44px] items-center gap-1 font-ui text-sm text-charcoal/60 active:text-br-green sm:min-h-0"
    >
      ← Voltar para linha do tempo
    </a>

    <header class="mt-4 border-b border-us-navy/10 pb-6 sm:mt-6 sm:pb-8">
      <div class="flex flex-wrap items-center gap-2">
        <time class="font-ui text-sm font-semibold text-br-gold">{event.data.dateLabel}</time>
        <span class:list={['rounded-full px-2.5 py-0.5 font-ui text-xs font-semibold uppercase tracking-wide', sideClass]}>
          <span class="sm:hidden">{timelineSideLabelsShort[event.data.side]}</span>
          <span class="hidden sm:inline">{sideLabel}</span>
        </span>
        {
          event.data.tags.map((tag) => (
            <span class="rounded-full bg-surface px-2.5 py-0.5 font-ui text-xs text-us-navy">
              {tag}
            </span>
          ))
        }
      </div>
      <h1 class="mt-3 font-display text-2xl font-bold leading-tight text-us-navy sm:mt-4 sm:text-3xl md:text-4xl">
        {event.data.title}
      </h1>
      <p class="mt-3 text-base leading-relaxed text-charcoal/70 sm:text-lg">{event.data.excerpt}</p>
    </header>

    <div class="prose mt-8 max-w-none sm:mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>
