---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import Timeline from '../components/Timeline.astro'

const posts = (await getCollection('newsletter')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)

const highlights = posts.slice(0, 2)
const olderPosts = posts.slice(2)
---

<BaseLayout title="EB2 em Foco">
  <section class="relative overflow-hidden border-b border-us-navy/10">
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-br-green/5 via-transparent to-us-navy/5"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute right-0 top-0 h-32 w-full opacity-[0.04]"
      aria-hidden="true"
    >
      <div class="flex h-full">
        <div class="flex-1 bg-us-red"></div>
        <div class="flex-1 bg-white"></div>
        <div class="flex-1 bg-us-navy"></div>
      </div>
    </div>

    <div class="relative mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-16 md:py-20">
      <p class="font-ui text-xs font-semibold uppercase tracking-widest text-br-green">
        Brasil → Estados Unidos
      </p>
      <h1 class="mt-2 max-w-2xl font-display text-[1.625rem] font-bold leading-tight text-us-navy sm:mt-3 sm:text-4xl md:text-5xl">
        Acompanhamento da pausa EB2 e vistos de imigrante
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-charcoal/75 sm:mt-4 sm:text-lg">
        Cobertura do caso <em>CLINIC v. Rubio</em> — a suspensão de vistos de imigrante para
        75 países, incluindo o Brasil, e o que muda na prática para requerentes EB2.
      </p>
      <div class="mt-6 flex flex-wrap gap-3 sm:mt-8">
        <a
          href="#destaques"
          class="inline-flex min-h-[48px] items-center rounded-full bg-br-green px-6 py-3 font-ui text-sm font-semibold text-white shadow-sm transition-colors active:bg-us-navy sm:min-h-0 sm:px-5 sm:py-2.5"
        >
          Últimas atualizações
        </a>
        <a
          href="#timeline"
          class="inline-flex min-h-[48px] items-center rounded-full border border-us-navy/20 bg-white px-6 py-3 font-ui text-sm font-semibold text-us-navy transition-colors active:bg-surface sm:min-h-0 sm:px-5 sm:py-2.5"
        >
          Linha do tempo
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    {
      highlights.length > 0 && (
        <section id="destaques" class="scroll-mt-20 sm:scroll-mt-24">
          <div class="mb-4 flex flex-wrap items-end justify-between gap-3 sm:mb-6">
            <div>
              <p class="font-ui text-xs font-semibold uppercase tracking-widest text-br-green">Em destaque</p>
              <h2 class="mt-1 font-display text-xl font-semibold text-us-navy sm:text-2xl">
                {highlights.length === 1 ? 'Última atualização' : 'Últimas atualizações'}
              </h2>
            </div>
            {olderPosts.length > 0 && (
              <a
                href="#posts"
                class="font-ui text-sm font-medium text-br-green active:text-us-navy"
              >
                Publicações anteriores ↓
              </a>
            )}
          </div>

          <div class:list={['grid gap-4 sm:gap-6', highlights.length > 1 && 'sm:grid-cols-2']}>
            {highlights.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-10 sm:mt-14">
      <Timeline />
    </div>

    {
      olderPosts.length > 0 && (
        <section id="posts" class="mt-10 scroll-mt-20 sm:mt-16 sm:scroll-mt-24">
          <div class="mb-6 sm:mb-8">
            <p class="font-ui text-xs font-semibold uppercase tracking-widest text-us-navy/60">Newsletter</p>
            <h2 class="mt-1 font-display text-xl font-semibold text-us-navy sm:text-2xl">Publicações anteriores</h2>
          </div>
          <div class="grid gap-6 sm:grid-cols-2">
            {olderPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
