---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import Timeline from '../components/Timeline.astro'

const posts = (await getCollection('newsletter')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)
---

<BaseLayout title="EB2 em Foco">
  <section class="relative overflow-hidden border-b border-us-navy/10">
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-br-green/5 via-transparent to-us-navy/5"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute right-0 top-0 h-32 w-full opacity-[0.04]"
      aria-hidden="true"
    >
      <div class="flex h-full">
        <div class="flex-1 bg-us-red"></div>
        <div class="flex-1 bg-white"></div>
        <div class="flex-1 bg-us-navy"></div>
      </div>
    </div>

    <div class="relative mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="font-ui text-xs font-semibold uppercase tracking-widest text-br-green">
        Brasil → Estados Unidos
      </p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl font-bold leading-tight text-us-navy sm:text-5xl">
        Acompanhamento da pausa EB2 e vistos de imigrante
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-charcoal/75">
        Cobertura do caso <em>CLINIC v. Rubio</em> — a suspensão de vistos de imigrante para
        75 países, incluindo o Brasil, e o que muda na prática para requerentes EB2.
      </p>
      <div class="mt-8">
        <a
          href="#posts"
          class="inline-flex items-center rounded-full bg-br-green px-5 py-2.5 font-ui text-sm font-semibold text-white shadow-sm transition-colors hover:bg-us-navy"
        >
          Ver atualizações
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <Timeline />

    <section id="posts" class="mt-16">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="font-ui text-xs font-semibold uppercase tracking-widest text-us-navy/60">Newsletter</p>
          <h2 class="mt-1 font-display text-2xl font-semibold text-us-navy">Últimas publicações</h2>
        </div>
      </div>

      {
        posts.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <p class="rounded-xl border border-dashed border-us-navy/20 bg-white p-8 text-center text-charcoal/60">
            Nenhuma publicação ainda. Em breve.
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>
