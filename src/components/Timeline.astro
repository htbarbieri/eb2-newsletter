---
import { getCollection } from 'astro:content'
import { timelineSideLabels, timelineSideLabelsShort } from '../data/timeline-labels'

const events = (await getCollection('timeline')).sort(
  (a, b) => b.data.sortDate.getTime() - a.data.sortDate.getTime(),
)
---

<section id="timeline" class="scroll-mt-20 rounded-2xl border border-us-navy/10 bg-white p-4 shadow-sm sm:scroll-mt-24 sm:p-6 md:p-8">
  <div class="mb-6 sm:mb-8">
    <p class="font-ui text-xs font-semibold uppercase tracking-widest text-br-green">Linha do tempo</p>
    <h2 class="mt-1 font-display text-xl font-semibold leading-snug text-us-navy sm:text-2xl">Marcos do caso CLINIC v. Rubio</h2>
    <p class="mt-2 text-sm leading-relaxed text-charcoal/70">
      De janeiro a agosto de 2026 — badges indicam o foco de cada marco, não o local físico.
    </p>
  </div>

  <ol class="relative space-y-0">
    {
      events.map((event, index) => (
        <li class="relative flex gap-3 pb-8 last:pb-0 sm:gap-4">
          {index < events.length - 1 && (
            <span
              class="absolute left-[9px] top-6 h-[calc(100%-12px)] w-0.5 bg-gradient-to-b from-br-gold to-us-navy/20 sm:left-[11px]"
              aria-hidden="true"
            />
          )}

          <span
            class:list={[
              'relative z-10 mt-1 h-5 w-5 shrink-0 rounded-full border-2 border-white shadow-sm sm:h-6 sm:w-6',
              event.data.side === 'br' ? 'bg-br-green' : 'bg-us-navy',
            ]}
            aria-hidden="true"
          />

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
              <time class="font-ui text-xs font-semibold text-br-gold">{event.data.dateLabel}</time>
              <span
                class:list={[
                  'rounded-full px-2 py-0.5 font-ui text-[10px] font-semibold uppercase tracking-wide sm:text-[10px]',
                  event.data.side === 'br'
                    ? 'bg-br-green/10 text-br-green'
                    : 'bg-us-navy/10 text-us-navy',
                ]}
              >
                <span class="md:hidden">{timelineSideLabelsShort[event.data.side]}</span>
                <span class="hidden md:inline">{timelineSideLabels[event.data.side]}</span>
              </span>
            </div>
            <h3 class="mt-1 font-display text-[15px] font-semibold leading-snug text-charcoal sm:text-base">{event.data.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-charcoal/70">{event.data.excerpt}</p>
            <a
              href={`/timeline/${event.id}`}
              class="mt-3 inline-flex min-h-[44px] items-center gap-1 font-ui text-sm font-medium text-br-green active:text-us-navy sm:min-h-0"
            >
              Ler detalhes
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </li>
      ))
    }
  </ol>
</section>
