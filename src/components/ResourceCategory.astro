---
import type { ResourceCategory } from '../data/recursos'

interface Props {
  category: ResourceCategory
}

const { category } = Astro.props

const accentMap = {
  green: 'border-t-br-green',
  navy: 'border-t-us-navy',
  gold: 'border-t-br-gold',
  red: 'border-t-us-red',
} as const

const badgeMap = {
  green: 'bg-br-green/10 text-br-green',
  navy: 'bg-us-navy/10 text-us-navy',
  gold: 'bg-br-gold/20 text-charcoal',
  red: 'bg-us-red/10 text-us-red',
} as const
---

<section id={category.id} class="scroll-mt-20 sm:scroll-mt-24">
  <div class="mb-4">
    <span class:list={['inline-block rounded-full px-3 py-1 font-ui text-xs font-semibold', badgeMap[category.accent]]}>
      {category.titulo}
    </span>
    <h2 class="mt-2 font-display text-lg font-semibold text-us-navy sm:text-xl">{category.titulo}</h2>
    <p class="mt-1 text-sm leading-relaxed text-charcoal/70">{category.descricao}</p>
  </div>

  <div class="grid gap-3 sm:grid-cols-2">
    {
      category.links.map((link) =>
        link.emBreve ? (
          <div
            class:list={[
              'block rounded-xl border border-dashed border-us-navy/20 border-t-4 bg-surface/50 p-4 opacity-90',
              accentMap[category.accent],
            ]}
          >
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-ui text-base font-semibold text-charcoal">{link.nome}</h3>
              <span class="shrink-0 rounded-full bg-br-gold/30 px-2 py-0.5 font-ui text-[10px] font-semibold uppercase tracking-wide text-charcoal">
                Em breve
              </span>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-charcoal/70">{link.descricao}</p>
          </div>
        ) : link.whatsapp || link.instagrams?.length || link.youtube ? (
          <div
            class:list={[
              'rounded-xl border border-us-navy/10 border-t-4 bg-white p-4 shadow-sm',
              accentMap[category.accent],
            ]}
          >
            <h3 class="font-ui font-semibold text-charcoal">{link.nome}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-charcoal/70">{link.descricao}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {link.instagrams?.map((ig) => (
                <a
                  href={`https://www.instagram.com/${ig.handle}/`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-[40px] items-center rounded-full border border-us-navy/15 px-3.5 py-1.5 font-ui text-sm font-medium text-us-navy active:bg-surface"
                >
                  Instagram{ig.label ? ` · ${ig.label}` : ''} ↗
                </a>
              ))}
              {link.youtube && (
                <a
                  href={`https://www.youtube.com/@${link.youtube}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-[40px] items-center rounded-full border border-us-navy/15 px-3.5 py-1.5 font-ui text-sm font-medium text-us-navy active:bg-surface"
                >
                  YouTube ↗
                </a>
              )}
              {link.whatsapp && (
                <a
                  href={`https://wa.me/${link.whatsapp}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-[40px] items-center rounded-full bg-br-green px-3.5 py-1.5 font-ui text-sm font-medium text-white active:bg-us-navy"
                >
                  WhatsApp ↗
                </a>
              )}
            </div>
            {link.regiao && (
              <p class="mt-2 font-ui text-xs text-br-green">{link.regiao}</p>
            )}
          </div>
        ) : (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'group block rounded-xl border border-us-navy/10 border-t-4 bg-white p-4 shadow-sm transition-all active:bg-surface sm:hover:-translate-y-0.5 sm:hover:shadow-md',
              accentMap[category.accent],
            ]}
          >
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-ui font-semibold text-charcoal group-hover:text-us-navy transition-colors">
                {link.nome}
              </h3>
              <span class="shrink-0 text-charcoal/30 group-hover:text-br-green transition-colors" aria-hidden="true">
                ↗
              </span>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-charcoal/70">{link.descricao}</p>
            {link.regiao && (
              <p class="mt-2 font-ui text-xs text-br-green">{link.regiao}</p>
            )}
          </a>
        ),
      )
    }
  </div>
</section>
