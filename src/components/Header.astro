---
const pathname = Astro.url.pathname

const navItems = [
  { href: '/', label: 'Newsletter' },
  { href: '/recursos', label: 'Imigrei - Primeiros Passos' },
]

function isActive(href: string) {
  if (href === '/') return pathname === '/'
  return pathname.startsWith(href)
}
---

<header class="sticky top-0 z-50 border-b border-us-navy/10 bg-cream/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="group flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-br-green to-us-navy shadow-sm">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
          <path d="M4 12h16M12 4l8 8-8 8" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div>
        <span class="font-display text-lg font-semibold text-us-navy group-hover:text-br-green transition-colors">
          EB2 em Foco
        </span>
        <span class="mt-0.5 flex items-center gap-1.5 font-ui text-xs text-charcoal/60">
          <span class="inline-block h-2 w-3 rounded-sm bg-br-green"></span>
          <span>→</span>
          <span class="inline-flex gap-0.5">
            <span class="inline-block h-2 w-3 rounded-sm bg-us-red"></span>
            <span class="inline-block h-2 w-3 rounded-sm bg-white ring-1 ring-us-navy/20"></span>
            <span class="inline-block h-2 w-3 rounded-sm bg-us-navy"></span>
          </span>
        </span>
      </div>
    </a>

    <nav class="flex items-center gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-full px-4 py-2 font-ui text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-us-navy text-white'
                : 'text-charcoal/70 hover:bg-surface hover:text-us-navy',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
