{
  "redirects": [
    {
      "source": "/recursos",
      "destination": "/dicas",
      "permanent": true
    },
    {
      "source": "/recursos/",
      "destination": "/dicas",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
